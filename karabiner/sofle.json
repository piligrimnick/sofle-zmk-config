{
  "title": "Sofleur: language keys and layout-independent symbol layer",
  "rules": [
    {
      "description": "Sofle: F19 selects Latin, F20 selects Cyrillic (double tap LOWER / RAISE)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f19",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^en$"
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 7504,
                  "product_id": 24926
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "f20",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "select_input_source": {
                "language": "^ru$"
              }
            }
          ],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "vendor_id": 7504,
                  "product_id": 24926
                }
              ]
            }
          ]
        }
      ]
    },
