/*
 * Sofle Choc V3.5 per-key RGB add-on.
 *
 * The controller-specific pin setup lives in boards/nice_nano_v2.overlay.
 * This shield intentionally does not define any separate underglow LEDs.
 *
 * SPDX-License-Identifier: MIT
 */

/ {
    behaviors {
        /* Internal global behavior used to tell both halves which of the five
         * Bluetooth-specific RGB slots is active. The short node name also
         * fits the ZMK split behavior protocol. */
        rgb_prof: rgb_prof {
            compatible = "zmk,behavior-sofle-rgb-profile";
            #binding-cells = <2>;
        };
    };
};
