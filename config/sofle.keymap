#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <behaviors/unicode.dtsi>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

#define LEFT_HAND_KEYS  \
    0 1 2 3 4 5        \
    12 13 14 15 16 17 \
    24 25 26 27 28 29 \
    36 37 38 39 40 41 42 \
    50 51 52 53 54

#define RIGHT_HAND_KEYS \
    6 7 8 9 10 11       \
    18 19 20 21 22 23   \
    30 31 32 33 34 35   \
    43 44 45 46 47 48 49 \
    55 56 57 58 59

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Left";
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Right";
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        td_yo: tap_dance_yo {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "T / Grave";
            tapping-term-ms = <200>;
            bindings = <&kp T>, <&kp GRAVE>;
        };

        td_hard: tap_dance_hard {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "M / RBKT";
            tapping-term-ms = <200>;
            bindings = <&kp M>, <&kp RBKT>;
        };

    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
// |   `   |  Q  |  W  |  E   |  R   | T/`  |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// |  TAB  | A/CMD | S/OPT | D/CTRL | F/SHFT | G |              | H | J/SHFT | K/CTRL | L/OPT | ;/CMD |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | SPACE  |  N   | M/]   |  ,    |  .   |   /   | SHIFT |
//               | CTRL | ALT | GUI | LOWER | ENTER |  | SPACE | RAISE | CTRL | ALT | GUI |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8     &kp N9   &kp N0   &kp BSPC
&kp GRAVE &kp Q  &kp W    &kp E    &kp R     &td_yo                           &kp Y  &kp U     &kp I      &kp O    &kp P    &kp LBKT
&kp TAB   &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G              &kp H &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp SPACE &kp N  &td_hard  &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LCTRL &kp LALT &kp LGUI &mo LOWER  &kp RET    &kp SPACE  &mo RAISE  &kp RCTRL &kp RALT &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------
// Punctuation is sent as Unicode code points instead of key positions, so the
// glyphs do not depend on the keyboard layout selected in the OS.  See the &uc
// node at the end of this file for the input system in use.  Digits are left
// out on purpose: the base layer already has them.
//
// Paired glyphs sit next to each other, and the home row carries the brackets
// and the operators used most while programming.
// ------------------------------------------------------------------------------------------------------------
// |  F1   | F2  | F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   | F10  |  F11  |  F12  |
// |   `   |  ~  |  <  |  >   |  \   | pipe |                   |  /   |  ?    |  '    |  "   |   ^   |   @   |
// |   =   |  (  |  )  |  {   |  }   |  _   |                   |  -   |  [    |  ]    |  ;   |   :   |   +   |
// |       |  !  |  #  |  $   |  %   |  &   |        |  |       |      |       |  ,    |  .   |   *   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6                            &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
&uc 0x60 0 &uc 0x7E 0 &uc 0x3C 0 &uc 0x3E 0 &uc 0x5C 0 &uc 0x7C 0                        &uc 0x2F 0 &uc 0x3F 0 &uc 0x27 0 &uc 0x22 0 &uc 0x5E 0 &uc 0x40 0
&uc 0x3D 0 &uc 0x28 0 &uc 0x29 0 &uc 0x7B 0 &uc 0x7D 0 &uc 0x5F 0                        &uc 0x2D 0 &uc 0x5B 0 &uc 0x5D 0 &uc 0x3B 0 &uc 0x3A 0 &uc 0x2B 0
&trans     &uc 0x21 0 &uc 0x23 0 &uc 0x24 0 &uc 0x25 0 &uc 0x26 0 &trans &trans          &none      &none      &uc 0x2C 0 &uc 0x2E 0 &uc 0x2A 0 &trans
                      &trans     &trans     &trans     &trans     &trans &trans  &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |  DEL  |
// |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |   0   |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans   &trans   &trans    &trans  &kp DEL
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans   &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans       &trans &trans  &trans    &trans   &trans   &trans    &trans  &trans
                        &trans       &trans        &trans       &trans       &trans &trans  &trans    &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        adjust_layer {
            display-name = "adjust";
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  | USB  | BLE  | STUDIO|      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | | SPACE  |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &out OUT_USB &out OUT_BLE &studio_unlock &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &trans &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };
    };
};

/* Unicode input system used by the LOWER layer.  In macOS mode the behavior
 * holds Option and types the hex code point, which only produces the glyph
 * while the "Unicode Hex Input" source is the active one. */
&uc {
    default-mode = <UC_MODE_MACOS>;
};
