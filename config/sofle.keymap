#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define RU 3
#define ADJUST 4

/* The two macOS input-source shortcuts, bound in the system settings to
 * "Select the previous input source" and "Select next source in Input menu".
 * With exactly two sources installed both simply swap the layout, so asking
 * for a specific language works as long as the marker layer below is in sync.
 *
 * They are kept apart rather than reusing one shortcut so that a tool able to
 * select a layout outright -- Karabiner's select_input_source, say -- can
 * later intercept them and make the choice absolute, without touching this
 * keymap.  On a machine without such a tool they keep working as plain
 * swaps. */
#define LANG_EN LG(SPACE)
#define LANG_RU LG(LS(SPACE))

#define LEFT_HAND_KEYS  \
    0 1 2 3 4 5        \
    12 13 14 15 16 17 \
    24 25 26 27 28 29 \
    36 37 38 39 40 41 42 \
    50 51 52 53 54

#define RIGHT_HAND_KEYS \
    6 7 8 9 10 11       \
    18 19 20 21 22 23   \
    30 31 32 33 34 35   \
    43 44 45 46 47 48 49 \
    55 56 57 58 59

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Left";
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Home Row Mod Right";
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_HAND_KEYS>;
            hold-trigger-on-release;
        };

        /* Hold for ё and ъ, tap for е and ь.  A tap-dance would have to sit
         * on the letter until its term expired, which lags the text by one
         * character on two of the most common Cyrillic letters.  A hold-tap
         * releases the letter the moment the key comes up instead.
         *
         * The held glyphs are BSLH and RBKT because the macOS "Russian"
         * layout keeps ё on the key right of ъ; "Russian - PC" would want
         * GRAVE for ё. */
        ht_yo: hold_tap_yo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "T / Ё";
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ht_hard: hold_tap_hard {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "M / Ъ";
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        /* Hold for the layer as before; tap twice to pick a language: lower
         * means Latin, raise means Cyrillic.  Each pair exists twice, once for
         * the base layer and once for the RU marker layer, so that asking for
         * the language already in use does nothing instead of toggling away
         * from it.  A tap-dance also fires the moment another key goes down,
         * so holding the layer and typing stays instant. */
        td_lower: tap_dance_lower {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Lower / Latin";
            tapping-term-ms = <170>;
            bindings = <&mo LOWER>, <&none>;
        };

        td_raise: tap_dance_raise {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Raise / Cyrillic";
            tapping-term-ms = <170>;
            bindings = <&mo RAISE>, <&to_ru>;
        };

        td_lower_ru: tap_dance_lower_ru {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Lower / Latin";
            tapping-term-ms = <170>;
            bindings = <&lower_en>, <&to_en>;
        };

        td_raise_ru: tap_dance_raise_ru {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            display-name = "Raise / Cyrillic";
            tapping-term-ms = <170>;
            bindings = <&mo RAISE>, <&none>;
        };

    };

    macros {
        /* Switches the OS input source and flips the firmware's own record of
         * the active language at the same time, so the two stay in step.  Any
         * switch made elsewhere (menu bar, another keyboard) desynchronises
         * them; &tog RU on the adjust layer puts the record back in line. */
        to_en: to_english {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG_EN>, <&tog RU>;
        };

        to_ru: to_russian {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG_RU>, <&tog RU>;
        };

        /* Holds the symbol layer under the Latin layout: switch once on the
         * way in, keep the layer for as long as the key is held, switch back
         * on release.  Switching per keystroke instead would pay the layout
         * change on every single glyph. */
        lower_en: lower_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&macro_tap &kp LANG_EN>
                , <&macro_wait_time 100>
                , <&macro_press &mo LOWER>
                , <&macro_pause_for_release>
                , <&macro_release &mo LOWER>
                , <&macro_wait_time 30>
                , <&macro_tap &kp LANG_RU>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | BKSPC |
// |   `   |  Q  |  W  |  E   |  R   | T/\  |                   |  Y   |  U    |  I    |  O   |   P   |   [   |
// |  TAB  | A/CMD | S/OPT | D/CTRL | F/SHFT | G |              | H | J/SHFT | K/CTRL | L/OPT | ;/CMD |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | SPACE  |  N   | M/]   |  ,    |  .   |   /   | SHIFT |
//               | CTRL | ALT | GUI | LOWER/EN | ENTER |  | SPACE | RAISE/RU | CTRL | ALT | GUI |
            bindings = <
&kp ESC   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8     &kp N9   &kp N0   &kp BSPC
&kp GRAVE &kp Q  &kp W    &kp E    &kp R     &ht_yo BSLH T                          &kp Y  &kp U     &kp I      &kp O    &kp P    &kp LBKT
&kp TAB   &hml LGUI A &hml LALT S &hml LCTRL D &hml LSHFT F &kp G              &kp H &hmr RSHFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_MUTE &kp SPACE &kp N  &ht_hard RBKT M &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LCTRL &kp LALT &kp LGUI &td_lower  &kp RET    &kp SPACE  &td_raise  &kp RCTRL &kp RALT &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------
// Digits are left out on purpose: the base layer already has them, which frees
// the row for F1-F12 and the whole ASCII punctuation set.  Paired glyphs sit
// next to each other, and the home row carries the brackets and the operators
// used most while programming.
//
// These are plain HID keycodes, so the glyphs are the ones the US layout
// produces.  Under a Cyrillic layout macOS reinterprets them as letters.
// ------------------------------------------------------------------------------------------------------------
// |  F1   | F2  | F3  |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   | F10  |  F11  |  F12  |
// |   `   |  ~  |  <  |  >   |  \   | pipe |                   |  /   |  ?    |  '    |  "   |   ^   |   @   |
// |   =   |  (  |  )  |  {   |  }   |  _   |                   |  -   |  [    |  ]    |  ;   |   :   |   +   |
// |       |  !  |  #  |  $   |  %   |  &   |        |  |       |      |       |  ,    |  .   |   *   |       |
//               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
&kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &kp F6                            &kp F7     &kp F8     &kp F9     &kp F10    &kp F11    &kp F12
&kp GRAVE  &kp TILDE  &kp LT     &kp GT     &kp BSLH   &kp PIPE                          &kp FSLH   &kp QMARK  &kp SQT    &kp DQT    &kp CARET  &kp AT
&kp EQUAL  &kp LPAR   &kp RPAR   &kp LBRC   &kp RBRC   &kp UNDER                         &kp MINUS  &kp LBKT   &kp RBKT   &kp SEMI   &kp COLON  &kp PLUS
&trans     &kp EXCL   &kp HASH   &kp DLLR   &kp PRCNT  &kp AMPS   &trans &trans          &none      &none      &kp COMMA  &kp DOT    &kp ASTRK  &trans
                      &trans     &trans     &trans     &trans     &trans &trans  &trans  &trans     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |  DEL  |
// |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |   0   |       |
// |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
// |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
//                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans   &trans   &trans    &trans  &kp DEL
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans   &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans       &trans &trans  &trans    &trans   &trans   &trans    &trans  &trans
                        &trans       &trans        &trans       &trans       &trans &trans  &trans    &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        ru_layer {
            display-name = "ru";
// Marker layer: the firmware knows from it that the OS is set to Cyrillic.
// The only real bindings are the two thumb keys, which mirror the base layer
// with the language roles swapped -- double tapping lower now returns to
// Latin, while double tapping raise does nothing.
            bindings = <
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans  &trans &trans &trans &trans &trans &trans
              &trans &trans &trans &td_lower_ru &trans &trans  &td_raise_ru &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };

        adjust_layer {
            display-name = "adjust";
// ----------------------------------------------------------------------------------------------------------------------------
// | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  | USB  | BLE  | STUDIO|      |       |       |
// | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
// | LANGFIX | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
// |        |         |         |         |         |         | RGB_TOG | | SPACE  |      |      |       |      |       |       |
//                    |         |         |         |         |         | |      |      |      |       |      |
            bindings = <
&bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &out OUT_USB &out OUT_BLE &studio_unlock &none &none &none
&ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &none
&tog RU           &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &none
&none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &trans &none &none &none &none &none &none
                                  &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp UP DOWN>;
        };
    };
};
